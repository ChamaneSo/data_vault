# The bootstrap container supplies random values for the three empty settings.
DATAVAULT_ENV=development
DATAVAULT_S3_HOST=0.0.0.0
DATAVAULT_S3_PORT=9000
DATAVAULT_ADMIN_HOST=0.0.0.0
DATAVAULT_ADMIN_PORT=9001
DATAVAULT_STORAGE_PATH=/var/lib/datavault
DATAVAULT_DATABASE_HOST=postgres
DATAVAULT_DATABASE_PORT=5432
DATAVAULT_DATABASE_NAME=datavault
DATAVAULT_DATABASE_USER=datavault
DATAVAULT_DATABASE_PASSWORD=
DATAVAULT_ADMIN_TOKEN=
DATAVAULT_MASTER_KEY=
DATAVAULT_REGION=us-east-1
DATAVAULT_LOG_LEVEL=info
DATAVAULT_METRICS_ENABLED=true
